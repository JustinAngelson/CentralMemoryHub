modules = ["python-3.11", "postgresql-16"]

[nix]
channel = "stable-24_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib"]

[deployment]
deploymentTarget = "vm"
run = ["bash", "start_all.sh"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start_all.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[workflows.workflow]]
name = "v2 dev"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash v2/dev.sh"

[workflows.workflow.metadata]
outputType = "console"

[userenv.development]
CMH_PUBLIC_URL = "http://localhost"
CMH_ENV = "dev"
CMH_ALLOWED_HOSTS = "127.0.0.1,localhost"
